# Base URL the frontend uses to reach the backend API.
# Copy this file to .env and adjust if needed.
VITE_API_BASE_URL=http://localhost:8000

# --- NASA FIRMS active fires (optional) ---
# By default the frontend reads NASA's open 24h global CSV archive, which
# needs no key. Set VITE_FIRMS_MAP_KEY to a free FIRMS MAP_KEY to use the
# keyed area API instead, or VITE_FIRMS_ENDPOINT to a self-hosted proxy
# that returns the same CSV schema (VITE_FIRMS_ENDPOINT wins if both set).
# Request a key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# VITE_FIRMS_MAP_KEY=
# VITE_FIRMS_ENDPOINT=

# --- Copernicus Sentinel-5P NO2 industrial emissions (optional) ---
# The "Industrial Emissions" layer stays inert until this is set. Point it
# at a WMS GetMap endpoint that serves the NO2 layer; the frontend appends
# the standard service/request/bbox parameters itself.
#   CDSE / Sentinel Hub WMS:
#     https://services.sentinel-hub.com/ogc/wms/<INSTANCE_ID>
#   Google Earth Engine (after publishing a WMS app):
#     https://earthengine.googleapis.com/v1/<PROJECT>/.../maps/<MAP_ID>/tiles
# TODO: Insert GEE/Copernicus WMS URL here (with your token/instance id).
# VITE_NO2_WMS_URL=
