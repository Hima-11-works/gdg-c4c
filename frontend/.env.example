# Base URL the frontend uses to reach the backend API.
# Copy this file to .env and adjust if needed.
VITE_API_BASE_URL=http://localhost:8000

# Show the citizen fire-report button. Disabled by default.
VITE_ENABLE_FIRE_REPORTING=false

# The satellite raster overlays (NASA GIBS True Color, GIBS Deep Blue AOD,
# Sentinel-5P NO2) need no frontend configuration: they are served through the
# backend's /api/v1/tiles/* proxy, which holds any credential and caches
# upstream tiles. See the repo-root .env.example for GIBS_BASE_URL,
# NO2_WMS_URL and NO2_WMS_TOKEN - the NO2 layer stays inert until those are set
# on the backend, not here.
