# Copy this file to .env (or run scripts/bootstrap.sh), then change the password.
# .env is the single configuration file for docker-compose and the backend.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=pollution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pollution
# Host and port used when the backend runs directly on your machine.
# docker-compose overrides these for the api container (host "db", port 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# When true, ingestion (python -m app.cli ingest/ingest-weather, and the
# pipeline's own ingestion stages) uses a fixed, deterministic PM2.5/wind
# dataset (app.ingestion.demo) instead of calling OpenAQ/Open-Meteo — no
# API key needed, and the scenario (a smog-episode-scale hotspot in Delhi
# NCR, matching INGEST_BBOX_* below, with a steady westerly wind) is
# guaranteed to produce a visible hotspot, downwind movement over
# +1h/+3h/+6h, and a CRITICAL alert. Everything past ingestion (H3 grid,
# IDW, PDI, dispersion, alerts, persistence, the API) is the real
# pipeline, unmodified, run for real on this synthetic input — see
# app.ingestion.factory. Not the same thing as a response's `is_demo`
# flag, which is unrelated (see app.core.config.Settings.demo_mode) — that
# flag governs app.services.demo_data's separate, country-wide illustrative
# fallback shown when a repository query finds nothing at all.
DEMO_MODE=false

# H3 resolution used for every h3_cell column. 0-15; higher = smaller cells.
# Changing this on an existing database does not rewrite stored h3_cell
# values, so treat a change as a breaking change to stored data.
H3_RESOLUTION=8

# Safety ceiling on a single level-of-detail read (GET /grid/current,
# /grid/forecast, /weather with a bounding box — a map viewport at some
# zoom level). A fine resolution paired with an accidentally huge bbox
# fails clearly and cheaply instead of enumerating millions of cells.
# Generous enough that frontend/src/lib/lod.ts's zoom/resolution tiers
# stay comfortably under it on an ordinary screen (see that module).
GRID_QUERY_MAX_CELLS=50000

# --- OpenAQ ingestion (python -m app.cli ingest) ---
# Get a free key at https://explore.openaq.org/register. Leave blank to
# run the API without ingestion — everything else works with demo data.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_TIMEOUT_SECONDS=10
OPENAQ_MAX_RETRIES=3
OPENAQ_LOCATIONS_LIMIT=100

# Bounding box to ingest (default: Delhi NCR, matching app.ingestion.demo's
# Demo Mode scenario). min/max lon/lat, WGS84. The country-wide demo/
# fallback dataset in app/services/demo_data.py is separate and spans many
# Indian cities, not just this one region.
INGEST_BBOX_MIN_LAT=28.40
INGEST_BBOX_MIN_LON=76.80
INGEST_BBOX_MAX_LAT=28.90
INGEST_BBOX_MAX_LON=77.50
# A reading older than this is considered stale and dropped.
INGEST_MAX_READING_AGE_HOURS=3

# --- Open-Meteo weather ingestion (python -m app.cli ingest-weather) ---
# No API key needed for the free tier.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10
OPEN_METEO_MAX_RETRIES=3
OPEN_METEO_MAX_LOCATIONS_PER_REQUEST=100

# Weather is fetched at this coarser H3 resolution and fanned out to every
# H3_RESOLUTION cell inside each sampled cell (weather varies far less over
# a city block than PM2.5 does, so one API call can cover many grid cells).
# Must be <= H3_RESOLUTION.
WEATHER_H3_RESOLUTION=5

# Safety ceiling on one weather run's fan-out. Cell count grows with bbox
# area: a country-sized box at H3_RESOLUTION=8 is ~11M cells. Ingestion
# refuses rather than trying to build and insert that many rows.
WEATHER_MAX_CELLS=50000

# --- PM2.5 estimation (app.services.estimation.IDWPollutionEstimator) ---
# A cell with no sensor within this radius, or fewer than IDW_MIN_SENSORS
# within it, gets no estimate (pm25=null) rather than a fabricated value.
IDW_MAX_DISTANCE_KM=15.0
IDW_MIN_SENSORS=2

# --- PDI: Pollution Development Index (app.services.pdi.HeuristicPDIModel) ---
# A heuristic pollution-pressure score, NOT a scientific measurement of
# emissions or absorption. PM2.5 (ug/m3) treated as "maximum pressure"
# when normalizing to [0, 1]. Also used by app.services.demo_data's
# illustrative PDI (see docs/architecture.md), so these four weights are
# the one place to tune it for both the real model and the demo fallback.
PDI_PM25_REFERENCE_UGM3=250.0
# Relative weights of each factor in the blend (road/industrial/vegetation
# have no real data source yet — see docs/architecture.md).
PDI_PM25_WEIGHT=0.7
PDI_ROAD_PRESSURE_WEIGHT=0.2
PDI_INDUSTRIAL_PRESSURE_WEIGHT=0.1
# Negative: vegetation/green cover is a pollution *sink*, not a pressure,
# so more of it pulls PDI down, not up.
PDI_VEGETATION_SINK_WEIGHT=-0.15

# --- Dispersion / forecast model (app.services.dispersion.DeterministicH3DispersionModel) ---
# NOT an atmospheric chemistry simulator — see docs/architecture.md.
DISPERSION_DECAY_RATE_PER_HOUR=0.15
DISPERSION_WET_REMOVAL_RATE_PER_HOUR=0.25
DISPERSION_PRECIPITATION_REFERENCE_MM=4.0
# Hard cap on how much of a cell's PM2.5 can move to neighbors in one
# hour, however strong the wind — the main guard against runaway values.
DISPERSION_MAX_TRANSPORT_FRACTION=0.6
DISPERSION_WIND_TRANSPORT_REFERENCE_MS=8.0
DISPERSION_CALM_WIND_THRESHOLD_MS=0.5
DISPERSION_WIND_CONE_HALF_ANGLE_DEG=50.0
DISPERSION_CONFIDENCE_DECAY_PER_HOUR=0.9
DISPERSION_MISSING_WEATHER_CONFIDENCE_PENALTY=0.5

# --- Alerts (app.services.alert_generation.AlertGenerationService) ---
# A very small rule-based engine, no machine learning — see
# docs/architecture.md's "Pipeline" section for all four rules.
# PM2.5 (ug/m3) at/above which a cell alerts WARNING/CRITICAL if
# happening now, or WATCH if only a forecast horizon reaches it.
# Defaults match the "Unhealthy" / "Very unhealthy" boundaries of the
# map's PM2.5 color bands (frontend/src/lib/colorScales.ts).
ALERT_WARNING_THRESHOLD_UGM3=80.0
ALERT_CRITICAL_THRESHOLD_UGM3=150.0
# Current-to-forecast PM2.5 jump that counts as a "sharp increase" alert
# on its own.
ALERT_SHARP_INCREASE_THRESHOLD_UGM3=25.0
# PDI considered "high pressure", and the (smaller) PM2.5 increase that
# counts as "worsening" when combined with it.
ALERT_PDI_HIGH_THRESHOLD=60.0
ALERT_PDI_WORSENING_MIN_INCREASE_UGM3=5.0
# A cell with an alert created within this many hours is skipped on the
# next pipeline run, and is what GET /api/v1/alerts considers "active".
ALERT_ACTIVE_LOOKBACK_HOURS=24.0

# --- Fire reports (citizen reports as modeled point sources) ---
# NOT a measurement: a smoke slider is a triage choice, and these knobs
# scale the modeled plume the reports justify (see app.services.fire_gradient).
# The extra PM2.5 (ug/m3) contribution of a maximum-intensity (5/5) report at
# its source cell, before kind weighting and age decay.
FIRE_SOURCE_PM25_UGM3=180.0
# Distance (km) from a report within which its influence falls off to zero.
FIRE_PLUME_RADIUS_KM=1.5
# Hours over which a report's influence halves as the fire ages.
FIRE_DECAY_HALF_LIFE_HOURS=4.0
# A report stops influencing the grid entirely after this many hours.
FIRE_REPORT_MAX_AGE_HOURS=12.0
# Hard ceiling (ug/m3) on a cell's final blended PM2.5.
FIRE_PM25_CAP_UGM3=400.0
