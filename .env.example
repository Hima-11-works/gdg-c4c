# Copy this file to .env (or run scripts/bootstrap.sh), then change the password.
# .env is the single configuration file for docker-compose and the backend.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=pollution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pollution
# Host and port used when the backend runs directly on your machine.
# docker-compose overrides these for the api container (host "db", port 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
