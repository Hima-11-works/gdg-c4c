# Copy this file to .env (or run scripts/bootstrap.sh), then change the password.
# .env is the single configuration file for docker-compose and the backend.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=pollution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pollution
# Host and port used when the backend runs directly on your machine.
# docker-compose overrides these for the api container (host "db", port 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# H3 resolution used for every h3_cell column. 0-15; higher = smaller cells.
# Changing this on an existing database does not rewrite stored h3_cell
# values, so treat a change as a breaking change to stored data.
H3_RESOLUTION=8

# --- OpenAQ ingestion (python -m app.cli ingest) ---
# Get a free key at https://explore.openaq.org/register. Leave blank to
# run the API without ingestion — everything else works with demo data.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_TIMEOUT_SECONDS=10
OPENAQ_MAX_RETRIES=3
OPENAQ_LOCATIONS_LIMIT=100

# Bounding box to ingest (default: San Francisco, matching the demo data
# in app/services/demo_data.py). min/max lon/lat, WGS84.
INGEST_BBOX_MIN_LAT=37.60
INGEST_BBOX_MIN_LON=-122.60
INGEST_BBOX_MAX_LAT=37.90
INGEST_BBOX_MAX_LON=-122.10
# A reading older than this is considered stale and dropped.
INGEST_MAX_READING_AGE_HOURS=3
