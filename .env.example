# Copy this file to .env (or run scripts/bootstrap.sh), then change the password.
# .env is the single configuration file for docker-compose and the backend.

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=pollution
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pollution
# Host and port used when the backend runs directly on your machine.
# docker-compose overrides these for the api container (host "db", port 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://air-health.vercel.app

# When true, ingestion (python -m app.cli ingest/ingest-weather, and the
# pipeline's own ingestion stages) uses a fixed, deterministic PM2.5/wind
# dataset (app.ingestion.demo) instead of calling OpenAQ/Open-Meteo — no
# API key needed, and the scenario (a smog-episode-scale hotspot in Delhi
# NCR, matching INGEST_BBOX_* below, with a steady westerly wind) is
# guaranteed to produce a visible hotspot, downwind movement over
# +1h/+3h/+6h, and a CRITICAL alert. Everything past ingestion (H3 grid,
# IDW, PDI, dispersion, alerts, persistence, the API) is the real
# pipeline, unmodified, run for real on this synthetic input — see
# app.ingestion.factory. Not the same thing as a response's `is_demo`
# flag, which is unrelated (see app.core.config.Settings.demo_mode) — that
# flag governs app.services.demo_data's separate, country-wide illustrative
# fallback shown when a repository query finds nothing at all.
DEMO_MODE=false

# H3 resolution used for every h3_cell column. 0-15; higher = smaller cells.
# Changing this on an existing database does not rewrite stored h3_cell
# values, so treat a change as a breaking change to stored data.
H3_RESOLUTION=8

# Safety ceiling on a single level-of-detail read (GET /grid/current,
# /grid/forecast, /weather with a bounding box — a map viewport at some
# zoom level). A fine resolution paired with an accidentally huge bbox
# fails clearly and cheaply instead of enumerating millions of cells.
# Generous enough that frontend/src/lib/lod.ts's zoom/resolution tiers
# stay comfortably under it on an ordinary screen (see that module).
GRID_QUERY_MAX_CELLS=50000

# --- OpenAQ ingestion (python -m app.cli ingest) ---
# Get a free key at https://explore.openaq.org/register. Leave blank to
# run the API without ingestion — everything else works with demo data.
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_TIMEOUT_SECONDS=10
OPENAQ_MAX_RETRIES=3
OPENAQ_LOCATIONS_LIMIT=100
# Global latest-PM2.5 pages sampled for India's coarse overview (bounded).
OPENAQ_NATIONAL_OVERVIEW_PAGES=5

# --- NASA FIRMS VIIRS near-real-time fire ingestion ---
# Request the free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Leave blank to keep FIRMS features unavailable; the baseline pipeline continues.
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
FIRMS_SOURCE=VIIRS_NOAA21_NRT
FIRMS_REGION=delhi-ncr
FIRMS_TIMEOUT_SECONDS=20
FIRMS_MAX_RETRIES=3
# Older detections are retained as history but flagged stale.
FIRMS_STALE_AFTER_HOURS=6

# --- Copernicus Sentinel-5P live UV aerosol-index hotspot scanning ---
# Create a free CDSE account at https://dataspace.copernicus.eu/ and set a
# refresh token. Tokens are secrets: keep this value out of commits/logs.
# The pipeline downloads only recent NRT L2 AER_AI swaths intersecting the
# configured ingest bbox. Without a token the stage reports "not configured".
CDSE_REFRESH_TOKEN=
HOTSPOT_SENTINEL5P_MAX_AGE_HOURS=30
HOTSPOT_SENTINEL5P_MIN_QUALITY=0.8
# Initial UVAI screening thresholds (dimensionless index, not calibrated
# pollution probabilities); calibrate with reviewed local detections.
HOTSPOT_SENTINEL5P_UVAI_THRESHOLD=1.0
HOTSPOT_SENTINEL5P_UVAI_STRONG_THRESHOLD=2.0
HOTSPOT_SENTINEL5P_H3_RESOLUTION=6
HOTSPOT_SENTINEL5P_TIMEOUT_SECONDS=60
HOTSPOT_SENTINEL5P_MAX_PRODUCTS=3
HOTSPOT_SCAN_BACKEND=filesystem
# Prepared traffic imports have no live provider configured by default.
TRAFFIC_STALE_AFTER_HOURS=2

# Bounding box to ingest (default: Delhi NCR, matching app.ingestion.demo's
# Demo Mode scenario). min/max lon/lat, WGS84. The country-wide demo/
# fallback dataset in app/services/demo_data.py is separate and spans many
# Indian cities, not just this one region.
INGEST_BBOX_MIN_LAT=28.40
INGEST_BBOX_MIN_LON=76.80
INGEST_BBOX_MAX_LAT=28.90
INGEST_BBOX_MAX_LON=77.50
# A reading older than this is considered stale and dropped.
INGEST_MAX_READING_AGE_HOURS=3

# --- Open-Meteo weather ingestion (python -m app.cli ingest-weather) ---
# No API key needed for the free tier.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10
OPEN_METEO_MAX_RETRIES=3
OPEN_METEO_MAX_LOCATIONS_PER_REQUEST=100

# Weather is fetched at this coarser H3 resolution and fanned out to every
# H3_RESOLUTION cell inside each sampled cell (weather varies far less over
# a city block than PM2.5 does, so one API call can cover many grid cells).
# Must be <= H3_RESOLUTION.
WEATHER_H3_RESOLUTION=5

# Safety ceiling on one weather run's fan-out. Cell count grows with bbox
# area: a country-sized box at H3_RESOLUTION=8 is ~11M cells. Ingestion
# refuses rather than trying to build and insert that many rows.
WEATHER_MAX_CELLS=50000

# --- PM2.5 estimation (app.services.estimation.IDWPollutionEstimator) ---
# A cell with no sensor within this radius, or fewer than IDW_MIN_SENSORS
# within it, gets no estimate (pm25=null) rather than a fabricated value.
IDW_MAX_DISTANCE_KM=15.0
IDW_MIN_SENSORS=2

# --- PDI: Pollution Development Index (app.services.pdi.HeuristicPDIModel) ---
# A heuristic pollution-pressure score, NOT a scientific measurement of
# emissions or absorption. PM2.5 (ug/m3) treated as "maximum pressure"
# when normalizing to [0, 1]. Also used by app.services.demo_data's
# illustrative PDI (see docs/architecture.md), so these four weights are
# the one place to tune it for both the real model and the demo fallback.
PDI_PM25_REFERENCE_UGM3=250.0
# Relative weights of each factor in the blend (road/industrial/vegetation
# have no real data source yet — see docs/architecture.md).
PDI_PM25_WEIGHT=0.7
PDI_ROAD_PRESSURE_WEIGHT=0.2
PDI_INDUSTRIAL_PRESSURE_WEIGHT=0.1
# Negative: vegetation/green cover is a pollution *sink*, not a pressure,
# so more of it pulls PDI down, not up.
PDI_VEGETATION_SINK_WEIGHT=-0.15

# --- Dispersion / forecast model (app.services.dispersion.DeterministicH3DispersionModel) ---
# NOT an atmospheric chemistry simulator — see docs/architecture.md.
DISPERSION_DECAY_RATE_PER_HOUR=0.15
DISPERSION_WET_REMOVAL_RATE_PER_HOUR=0.25
DISPERSION_PRECIPITATION_REFERENCE_MM=4.0
# Hard cap on how much of a cell's PM2.5 can move to neighbors in one
# hour, however strong the wind — the main guard against runaway values.
DISPERSION_MAX_TRANSPORT_FRACTION=0.6
DISPERSION_WIND_TRANSPORT_REFERENCE_MS=8.0
DISPERSION_CALM_WIND_THRESHOLD_MS=0.5
DISPERSION_WIND_CONE_HALF_ANGLE_DEG=50.0
DISPERSION_CONFIDENCE_DECAY_PER_HOUR=0.9
DISPERSION_MISSING_WEATHER_CONFIDENCE_PENALTY=0.5

# --- Alerts (app.services.alert_generation.AlertGenerationService) ---
# A very small rule-based engine, no machine learning — see
# docs/architecture.md's "Pipeline" section for all four rules.
# PM2.5 (ug/m3) at/above which a cell alerts WARNING/CRITICAL if
# happening now, or WATCH if only a forecast horizon reaches it.
# Defaults sit on the CPCB NAQI PM2.5 band boundaries (Poor 91, Very Poor
# 121) that the map's color scale uses (frontend/src/lib/colorScales.ts).
# backend/tests/test_alert_threshold_bands.py fails if these stop matching
# the map's bands.
ALERT_WARNING_THRESHOLD_UGM3=91.0
ALERT_CRITICAL_THRESHOLD_UGM3=121.0
# Current-to-forecast PM2.5 jump that counts as a "sharp increase" alert
# on its own.
ALERT_SHARP_INCREASE_THRESHOLD_UGM3=25.0
# PDI considered "high pressure", and the (smaller) PM2.5 increase that
# counts as "worsening" when combined with it.
ALERT_PDI_HIGH_THRESHOLD=60.0
ALERT_PDI_WORSENING_MIN_INCREASE_UGM3=5.0
# A cell with an alert created within this many hours is skipped on the
# next pipeline run, and is what GET /api/v1/alerts considers "active".
ALERT_ACTIVE_LOOKBACK_HOURS=24.0

# --- Fire reports (citizen reports as modeled point sources) ---
# NOT a measurement: a smoke slider is a triage choice, and these knobs
# scale the modeled plume the reports justify (see app.services.fire_gradient).
# A report only reaches this model once a reviewer has CORROBORATED it, so
# these knobs scale what a *verified* report contributes - never what an
# anonymous claim does.
# The extra PM2.5 (ug/m3) contribution of a maximum-intensity (5/5) report at
# its source cell, before kind weighting and age decay.
FIRE_SOURCE_PM25_UGM3=180.0
# Distance (km) from a report within which its influence falls off to zero.
FIRE_PLUME_RADIUS_KM=1.5
# Hours over which a report's influence halves as the fire ages.
FIRE_DECAY_HALF_LIFE_HOURS=4.0
# The report window. A report is EXPIRED past this, which also fixes expires_at
# at submission so the read side and the model agree on what is still active.
# Corroboration does not outlive the window: a corroborated report that has
# aged out contributes nothing.
FIRE_REPORT_MAX_AGE_HOURS=12.0
# Hard ceiling (ug/m3) on a cell's final blended PM2.5.
FIRE_PM25_CAP_UGM3=400.0
# PDI weight for the fire-report pressure factor (a triage choice like the
# other PDI weights).
PDI_FIRE_PRESSURE_WEIGHT=0.25

# --- Citizen report trust (POST /api/v1/reports, F1) ---
# The submission endpoint is unauthenticated, so its coordinates and volume are
# attacker-controlled. See docs/api/citizen-reports.md.
#
# Shared key for the review endpoints. Deliberately NOT per-person identity: the
# platform has no user accounts, and a fake identity system would be worse than
# an honest shared secret. LEAVING IT UNSET TURNS REVIEW OFF (503) - it never
# means "anyone may corroborate". Generate with: openssl rand -hex 32
# Leave EMPTY to keep review off: POST /api/v1/reports/{id}/moderation and
# .../audit then answer 503. That is deliberate - an unconfigured reviewer path
# must not mean "anyone may corroborate a report".
REPORTS_REVIEWER_KEY=
# Submissions per hour allowed from one /24 network prefix. The source unit is
# a /24, never a full client address: coarse enough to blunt a flood, far less
# identifying to store. Restarting the API does not reset this - the count
# comes from stored rows, not from memory.
REPORTS_RATE_LIMIT_PER_HOUR=5
# Submissions per hour allowed platform-wide, so many sources cannot fill the
# table before a human looks at anything. Must be >= the per-source cap.
REPORTS_GLOBAL_LIMIT_PER_HOUR=500
# A report of the same kind in the same cell inside this window joins the open
# claim already there as corroboration, rather than becoming an independent one.
REPORTS_CLUSTER_WINDOW_HOURS=6.0
# Reports a cluster needs before it is worth a reviewer's attention. A count for
# a queue, NOT an auto-promotion rule: nothing corroborates a report without a
# reviewer.
REPORTS_CLUSTER_CORROBORATION_THRESHOLD=2
# Whether a report must fall inside the India geofence (ADM1 states/UTs) to be
# accepted. The platform is India-only, so this defaults to on. Turn it off only
# to test the fence itself; a report accepted with it off is recorded as
# india_geofence_verified=false rather than pretending it was checked.
REPORTS_REQUIRE_INDIA_GEOFENCE=true

# --- Citizen photo evidence storage ---
# Keep disabled until a durable private store is configured. On Vercel, use
# s3 (AWS S3 or Cloudflare R2); filesystem storage is for a persistent single
# server only. Uploaded image bytes are capped at 4 MiB to fit Vercel's request
# size limit with multipart overhead.
CITIZEN_MEDIA_STORAGE=disabled
CITIZEN_MEDIA_MAX_BYTES=4194304
# Required only when CITIZEN_MEDIA_STORAGE=s3. Keep the bucket private.
CITIZEN_MEDIA_S3_BUCKET=
CITIZEN_MEDIA_S3_REGION=us-east-1
# Leave blank for AWS S3; set the provider's S3 API endpoint for R2/compatible stores.
CITIZEN_MEDIA_S3_ENDPOINT_URL=
CITIZEN_MEDIA_S3_ACCESS_KEY_ID=
CITIZEN_MEDIA_S3_SECRET_ACCESS_KEY=

# --- Authority response simulator ---
# Writes to /api/v1/incidents require this key and a configured actor identity.
# Leave blank to keep simulator writes disabled. This is a demo credential,
# not production authentication.
SIMULATOR_API_KEY=
# Comma-separated actor_id:role[:jurisdiction] registry. Role and jurisdiction
# are resolved on the backend and cannot be changed by a client request.
SIMULATOR_ACTORS=dispatch:pollution_control:Delhi,fire-unit-7:fire_department:Delhi

# --- Satellite raster tile proxy (GET /api/v1/tiles/*) ---
# The web map's raster overlays (NASA GIBS True Color, GIBS Deep Blue AOD, and
# Sentinel-5P NO2) are served through the backend so the browser only talks to
# this API, and so a credential can stay server-side. No key is needed for
# GIBS.
#
# GIBS WMTS base for those two layers. Override only to point at a mirror.
GIBS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best
# Sentinel-5P NO2 WMS GetMap endpoint, e.g. a Copernicus Data Space /
# Sentinel Hub WMS instance, or a Google Earth Engine WMS app.
# TODO: paste your endpoint here to enable the map's "Industrial Emissions"
# layer. While this is blank, GET /api/v1/tiles/no2/* answers 404 and the
# layer stays inert - it never draws invented heat where real NO2 belongs.
NO2_WMS_URL=
# WMS layer name to request. TODO: providers differ - "NO2" for a plain CDSE
# layer, a project-scoped layer path for GEE.
NO2_WMS_LAYER=NO2
# TODO: the token/credential for that endpoint, if it needs one. It is sent
# upstream only and never reaches the browser or a log line. If your provider
# wants a parameter other than `token` (GEE uses `key=`), put the credential in
# NO2_WMS_URL's own query string instead and leave this blank.
NO2_WMS_TOKEN=
# One upstream tile fetch (seconds), and how many times to retry a 429/5xx.
TILE_TIMEOUT_SECONDS=15
TILE_MAX_RETRIES=2
# In-process tile cache: entries, and how long a tile stays fresh. Bounded so a
# long-running process cannot grow without limit; 0 entries disables it.
TILE_CACHE_MAX_ENTRIES=512
TILE_CACHE_TTL_SECONDS=3600
